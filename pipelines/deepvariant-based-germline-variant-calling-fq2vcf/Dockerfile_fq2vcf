# Single-container fq2vcf: FASTQ -> {sorted BAM | VCF} in one image.
#
# Aligners: bwa-mem2, mm2-fast (minimap2), bwa-meth, STAR  (selected at runtime via --aligner)
# Variant calling: DeepVariant 1.9.0 (prebuilt binaries copied from docker.io/google/deepvariant:1.9.0),
#                  run only for bwa-mem2 (--model_type=WGS) and mm2-fast (--model_type=PACBIO);
#                  bwa-meth/STAR stop at the sorted, indexed BAM.
#
# Build (run from the repository root, NOT this pipeline directory):
#   docker build -f pipelines/deepvariant-based-germline-variant-calling-fq2vcf/Dockerfile_fq2vcf \
#                -t fq2vcf:dv1.9.0 .

################################################################################
# Stage 1: conda env for the orchestration scripts (mpi4py, pragzip, yappi, ...)
################################################################################
FROM condaforge/miniforge3 AS conda_setup
WORKDIR /Open-Omics-Acceleration-Framework/pipelines/deepvariant-based-germline-variant-calling-fq2vcf/
COPY pipelines/deepvariant-based-germline-variant-calling-fq2vcf/environment.yml .
RUN conda env create --name dv_env -f environment.yml

################################################################################
# Stage 2: prebuilt DeepVariant 1.9.0 -- used only as a source of binaries
################################################################################
FROM docker.io/google/deepvariant:1.9.0 AS dv_image

################################################################################
# Stage 3: build bwa-mem2, mm2-fast, STAR, htslib, samtools, bcftools, bwa-meth
################################################################################
FROM ubuntu:20.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git wget ca-certificates autoconf numactl \
        zlib1g-dev libncurses5-dev libbz2-dev liblzma-dev \
        gcc-11 g++-11 python3 python3-pip \
    && unlink /usr/bin/gcc && unlink /usr/bin/g++ \
    && ln -s /usr/bin/gcc-11 /usr/bin/gcc && ln -s /usr/bin/g++-11 /usr/bin/g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /Open-Omics-Acceleration-Framework
COPY . .

# bwa-mem2
WORKDIR /Open-Omics-Acceleration-Framework/applications/bwa-mem2
RUN make multi

# mm2-fast (accelerated minimap2)
WORKDIR /Open-Omics-Acceleration-Framework/applications/mm2-fast
RUN make

# STAR
WORKDIR /Open-Omics-Acceleration-Framework/applications/STAR/source
RUN make STAR

# htslib (needed by samtools/bcftools)
WORKDIR /Open-Omics-Acceleration-Framework/applications/htslib
RUN autoreconf -i && ./configure && make

# samtools
WORKDIR /Open-Omics-Acceleration-Framework/applications/samtools
RUN autoheader && autoconf -Wno-syntax && chmod 775 configure && ./configure && make

# bcftools (used by merge_vcf.sh to concatenate per-rank VCFs)
WORKDIR /Open-Omics-Acceleration-Framework/applications/bcftools
RUN make

# bwa-meth (python wrapper driving bwa-mem2 for bisulfite/methylation alignment)
WORKDIR /Open-Omics-Acceleration-Framework/applications/bwa-meth
RUN wget -q https://pypi.python.org/packages/source/t/toolshed/toolshed-0.4.0.tar.gz \
    && tar xzf toolshed-0.4.0.tar.gz \
    && (cd toolshed-0.4.0 && python3 setup.py install) \
    && python3 setup.py install

################################################################################
# Stage 4: final image -- assemble aligners + conda env + DeepVariant 1.9.0
################################################################################
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        zlib1g libncurses5 libbz2-1.0 liblzma5 numactl python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=conda_setup /opt/conda /opt/conda
COPY --from=builder /Open-Omics-Acceleration-Framework /Open-Omics-Acceleration-Framework
COPY --from=dv_image /opt/deepvariant /opt/deepvariant

ENV PATH="/opt/conda/envs/dv_env/bin:/opt/conda/bin:/opt/deepvariant/bin:\
/Open-Omics-Acceleration-Framework/applications/bwa-mem2:\
/Open-Omics-Acceleration-Framework/applications/mm2-fast:\
/Open-Omics-Acceleration-Framework/applications/STAR/source:\
/Open-Omics-Acceleration-Framework/applications/samtools:\
/Open-Omics-Acceleration-Framework/applications/bcftools:\
/Open-Omics-Acceleration-Framework/applications/bwa-meth:$PATH"
ENV LD_PRELOAD="/Open-Omics-Acceleration-Framework/pipelines/deepvariant-based-germline-variant-calling-fq2vcf/libmimalloc.so.2.0"
RUN echo "source activate dv_env" >> ~/.bashrc

RUN mkdir -p /input /output /refdir /tempdir
WORKDIR /Open-Omics-Acceleration-Framework/pipelines/deepvariant-based-germline-variant-calling-fq2vcf/
CMD ["/bin/bash"]
